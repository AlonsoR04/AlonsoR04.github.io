---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/polo.jpg';
import { cvPath, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="card hero span-3 row-2" aria-labelledby="hero-title">
  <Image
    src={photo}
    alt=""
    widths={[360, 560, 720]}
    sizes="(max-width: 560px) 60vw, 420px"
    loading="eager"
    class="hero__photo"
  />
  <p class="hero__eyebrow">{t('hero.eyebrow')}</p>
  <h1 id="hero-title">
    <span class="visually-hidden">Alonso Ríos Guerra — </span>{t('hero.title')}
  </h1>
  <p class="hero__lead">{t('hero.lead')}</p>
  <div class="hero__actions">
    <a class="btn btn--light" href="#work">{t('hero.work')}</a>
    <a class="btn btn--outline-light" href={cvPath[lang]} download>
      <Icon name="download" />{t('hero.cv')}
    </a>
  </div>
</section>

<div class="card">
  <p class="label">{t('now.label')}</p>
  <p class="tile__title">{t('now.role')}</p>
  <p class="tile__meta">{t('now.org')}</p>
</div>

<div class="card">
  <p class="label">{t('edu.label')}</p>
  <p class="tile__title">{t('edu.title')}</p>
  <p class="tile__meta">{t('edu.org')}</p>
</div>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-strong) 100%);
    color: var(--color-on-primary);
    padding: clamp(28px, 5vw, 48px);
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -90px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }
  /* Foto de fondo en duotono azul: el blanco se funde con el degradado y el texto queda encima. */
  .hero__photo {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 100%;
    width: 50%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 55%);
    mask-image: linear-gradient(to right, transparent 0%, #000 55%);
    pointer-events: none;
  }
  .hero > :not(.hero__photo) {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 560px) {
    .hero__photo {
      width: 70%;
      height: 70%;
      opacity: 0.55;
    }
  }
  .hero__eyebrow {
    display: inline-block;
    margin: 0;
    background: rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    padding: 0.3rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  h1 {
    font-size: clamp(2rem, 5.6vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    margin: 1rem 0 0.9rem;
    max-width: 16ch;
  }
  .hero__lead {
    max-width: 48ch;
    margin: 0 0 1.6rem;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    position: relative;
    z-index: 1;
  }
  .tile__title {
    margin: 0 0 0.3rem;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .tile__meta {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.93rem;
  }
</style>
