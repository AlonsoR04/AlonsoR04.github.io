---
import VideoFacade from './VideoFacade.astro';
import poster from '../assets/churnanchor-poster.jpg';
import { churnAnchor } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = churnAnchor.text[lang];
---

<div id="work" class="section-head">
  <p class="label">{t('work.label')}</p>
</div>

<article class="card span-4 case" aria-labelledby="case-title">
  <div class="case__video">
    <VideoFacade videoId={churnAnchor.videoId} poster={poster} label={c.videoLabel} title="ChurnAnchor Showcase" />
  </div>
  <div class="case__intro">
    <span class="badge">{c.badge}</span>
    <h2 id="case-title">ChurnAnchor</h2>
    <p class="case__subtitle">{c.subtitle}</p>
    <p class="case__summary">{c.summary}</p>
    <dl class="stats">
      {c.stats.map((s) => (
        <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
      ))}
    </dl>
    <ul class="chips" aria-label="Tech stack">
      {churnAnchor.stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</article>

<section class="card span-4 details" aria-labelledby="case-built">
  <div>
    <h3 class="label">{c.problemTitle}</h3>
    <p class="details__problem">{c.problem}</p>
  </div>
  <div>
    <h3 class="label" id="case-built">{c.builtTitle}</h3>
    <ul class="list">
      {c.built.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>

<p class="span-4 case__note">{c.note}</p>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: center;
    padding: clamp(16px, 2.5vw, 24px);
  }
  @media (max-width: 900px) {
    .case {
      grid-template-columns: 1fr;
    }
  }
  .case__intro {
    padding: 0 clamp(4px, 1vw, 12px);
  }
  @media (max-width: 900px) {
    .case__intro {
      padding: 4px 8px 8px;
    }
  }
  .badge {
    display: inline-block;
    background: var(--color-primary-soft);
    color: var(--color-primary-strong);
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .case h2 {
    font-size: clamp(1.8rem, 4.5vw, 2.4rem);
    letter-spacing: -0.035em;
    margin: 0.7rem 0 0.2rem;
    line-height: 1.1;
  }
  .case__subtitle {
    margin: 0 0 0.9rem;
    font-weight: 600;
    color: var(--color-primary-strong);
  }
  .case__summary {
    margin: 0 0 1.1rem;
    color: var(--color-muted);
  }
  .stats {
    display: flex;
    gap: 1.5rem;
    margin: 0 0 1.1rem;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dd {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    line-height: 1.1;
  }
  .stats dt {
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  .details {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(22px, 3.5vw, 32px);
  }
  @media (max-width: 760px) {
    .details {
      grid-template-columns: 1fr;
    }
  }
  .details__problem {
    margin: 0;
  }
  .list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }
  .list li::marker {
    color: var(--color-primary);
    font-weight: 700;
  }
  .case__note {
    margin: 0;
    padding: 0 4px;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
