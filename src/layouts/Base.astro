---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
// Precarga de la fuente: evita que el texto se recoloque al cambiar de la fuente del sistema (CLS).
import fontUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import { languages, type Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(localizePath(Astro.url.pathname, l), site).href,
}));
const xDefault = new URL(localizePath(Astro.url.pathname, 'en'), site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#2357f5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <slot />
  </body>
</html>
